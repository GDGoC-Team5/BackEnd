# 복사해서 .env 로 사용 (.env 는 커밋 금지)
# docker compose 와 IntelliJ 실행이 모두 이 파일을 읽는다.

DB_NAME=studyhub
# root 는 MySQL 컨테이너에서 MYSQL_USER 로 쓸 수 없으므로 전용 계정을 사용한다
DB_USERNAME=studyhub
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 도커 MySQL 을 호스트에 노출할 포트 (로컬 MySQL 3306 과 충돌 방지)
DB_PORT=3307

# IntelliJ 에서 앱을 실행할 때 사용하는 주소 (도커 실행 시에는 compose 가 덮어씀)
DB_URL=jdbc:mysql://localhost:3307/studyhub?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
